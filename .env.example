# =========================================================
# APPLICATION
# =========================================================

APP_ENV=dev

# =========================================================
# POSTGRESQL
# =========================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

IDENTITY_DB=identity_db
ORDER_DB=order_db
PAYMENT_DB=payment_db

# =========================================================
# MONGODB
# =========================================================

MONGO_HOST=mongodb
MONGO_PORT=27017

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

MONGO_DATABASE=product_db

# =========================================================
# REDIS
# =========================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# =========================================================
# RABBITMQ
# =========================================================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=rabbit123

RABBITMQ_VHOST=/

# Order/Payment throughput settings (bounded batches; tune after load testing)
OUTBOX_POLL_MS=50
OUTBOX_BATCH_SIZE=200
OUTBOX_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_CONSUMERS=4
RABBITMQ_PREFETCH=50

# =========================================================
# API GATEWAY
# =========================================================

GATEWAY_PORT=8080

# =========================================================
# SERVICES
# =========================================================

IDENTITY_SERVICE_HOST=identity-service
IDENTITY_SERVICE_PORT=8081

PRODUCT_SERVICE_HOST=product-service
PRODUCT_SERVICE_PORT=8082

ORDER_SERVICE_HOST=order-inventory-service
ORDER_SERVICE_PORT=8083

PAYMENT_SERVICE_HOST=payment-service
PAYMENT_SERVICE_PORT=8084

NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=8085

# Real SMTP for docker-compose.production.yml. Use a public HTTPS Gateway URL.
# Local docker-compose.yml uses Mailpit and ignores these SMTP settings.
EMAIL_VERIFICATION_BASE_URL=https://api.example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-account
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false

# =========================================================
# JWT
# =========================================================

JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_example
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# =========================================================
# GRAFANA
# =========================================================

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# =========================================================
# PROMETHEUS
# =========================================================

PROMETHEUS_PORT=9090

# PAYMENT PROVIDER: mock for deterministic Day 13/14 demos, payos for real checkout
PAYMENT_PROVIDER=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/api/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:8080/api/payments/payos/cancel
PAYOS_WEBHOOK_URL=
PAYOS_TIMEOUT_MS=10000
PAYOS_LINK_TTL_SECONDS=900
PAYOS_POLL_MS=15000
