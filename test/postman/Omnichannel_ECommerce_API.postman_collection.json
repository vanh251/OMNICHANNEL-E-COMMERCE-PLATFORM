      "name": "01. Authentication & Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van A\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"phone\": \"0987654321\",\n  \"address\": \"123 Cau Giay, Hanoi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Dang ky tai khoan khach hang moi (mac dinh role USER, emailVerified=false)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.test(\"User registered with emailVerified = false\", function () {",
                  "        pm.expect(data.emailVerified).to.eql(false);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-verification"
              ]
            },
            "description": "Yeu cau gui lai lien ket xac minh email cho tai khoan dang dang nhap (Bearer JWT). Gioi han: 1 lan/phut va toi da 5 lan/ngay. Tra ve 202 Accepted hoac 429 Too Many Requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202 or 429\", function () {",
                  "    pm.expect([202, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
