    },
    {
      "name": "03. Orders & Inventory",
      "item": [
        {
          "name": "Create Order (Dat hang)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.id) {",
                  "        pm.collectionVariables.set('orderId', data.id);",
                  "        console.log('Set orderId:', data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Pho Hue, Hai Ba Trung, Hanoi\",\n  \"note\": \"Giao trong gio hanh chinh\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"sku\": \"DEMO-PAYOS-2K\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Dat hang (Khoi tao Saga: kiem tra ton kho, tao don PENDING va phat OrderCreatedEvent)."
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Tra cuu chi tiet don hang (chi chu don; ADMIN dung endpoint /api/orders/admin/{id})."
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "my-orders"
              ]
            },
            "description": "Lay danh sach tat ca cac don hang cua nguoi dung hien tai."
          }
        },
        {
          "name": "Cancel Order (Chu don huy PENDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "Huy don hang (Chi cho phep khi don o trang thai PENDING; neu CONFIRMED tra ve 409 Conflict)."
          }
        },
        {
          "name": "Admin List Orders (Loc trang thai)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/admin?status=CONFIRMED&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "admin"],
              "query": [
                { "key": "status", "value": "CONFIRMED" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "ADMIN xem don hang phan trang, co the bo status de xem tat ca."
          }
        },
        {
          "name": "Admin Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/admin/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "admin", "{{orderId}}"]
            },
            "description": "ADMIN xem chi tiet don hang bat ky."
          }
        },
        {
          "name": "Admin Start Shipping",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/ship",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "ship"]
            },
            "description": "ADMIN chuyen CONFIRMED sang SHIPPING; goi lap lai tra 409."
          }
        },
        {
          "name": "Customer Confirm Receipt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/confirm-receipt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "confirm-receipt"]
            },
            "description": "Chu don xac nhan da nhan hang, chuyen SHIPPING sang COMPLETED; goi lap lai tra 409."
          }
        }
      ]
    },
    {
      "name": "04. Payments & PayOS",
      "item": [
        {
          "name": "Get Payment Details & VietQR Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.id) {",
                  "        pm.collectionVariables.set('paymentId', data.id);",
                  "    }",
                  "    if (data.checkoutUrl) {",
                  "        console.log('PayOS Checkout URL:', data.checkoutUrl);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{orderId}}"
              ]
            },
            "description": "Lay thong tin thanh toan cua don hang. Neu bat mode payos, tra ve checkoutUrl va qrCode de khach quet thanh toan."
          }
        },
        {
          "name": "Refund Payment [ADMIN]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "refund"
              ]
            },
            "description": "Hoan tien cho giao dich thanh toan (Yeu cau ADMIN va don hang da co dau huy)."
          }
        },
        {
          "name": "PayOS Webhook (Mock Callback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"00\",\n  \"desc\": \"success\",\n  \"data\": {\n    \"orderCode\": 123456,\n    \"amount\": 2000,\n    \"description\": \"Thanh toan don hang\",\n    \"accountNumber\": \"123456789\",\n    \"reference\": \"FT123456\",\n    \"transactionDateTime\": \"2026-10-13 17:00:00\",\n    \"currency\": \"VND\",\n    \"paymentLinkId\": \"link123\",\n    \"code\": \"00\",\n    \"desc\": \"success\"\n  },\n  \"signature\": \"sample_signature_hash\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhooks/payos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "webhooks",
                "payos"
              ]
            },
            "description": "Endpoint nhan thong bao thanh toan thanh cong tu PayOS (Yeu cau chu ky so hop le)."
          }
        },
        {
          "name": "PayOS Return URL (Page Callback)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/payos/return?orderCode=123456&status=PAID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "payos",
                "return"
              ],
              "query": [
                {
                  "key": "orderCode",
                  "value": "123456"
                },
                {
                  "key": "status",
                  "value": "PAID"
                }
              ]
            },
            "description": "Trang dieu huong khach hang sau khi thanh toan PayOS thanh cong."
          }
        },
        {
          "name": "PayOS Cancel URL (Cancel Callback)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/payos/cancel?orderCode=123456&status=CANCELLED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "payos",
                "cancel"
              ],
              "query": [
                {
                  "key": "orderCode",
                  "value": "123456"
                },
                {
                  "key": "status",
                  "value": "CANCELLED"
                }
              ]
            },
            "description": "Trang dieu huong khi khach hang bam huy thanh toan tren cong PayOS."
          }
        }
      ]
    },
